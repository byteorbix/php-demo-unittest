{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run PHPUnit Tests",
            "type": "shell",
            "command": "./vendor/bin/phpunit",
            "args": ["--configuration", "phpunit.xml", "--colors=always"],
            "group": { "kind": "test", "isDefault": true },
            "options": {
                "env": {
                    "XDEBUG_MODE": "coverage"
                }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Run PHPUnit with Coverage",
            "type": "shell",
            "command": "./vendor/bin/phpunit",
            "args": ["--configuration", "phpunit.xml", "--coverage-text"],
            "group": "test",
            "options": {
                "env": {
                    "XDEBUG_MODE": "coverage"
                }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        }
    ]
}
